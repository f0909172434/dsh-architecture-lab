diff --git a/test/host-adapter.spec.ts b/test/host-adapter.spec.ts
new file mode 100644
index 0000000..6ebd7ac
--- /dev/null
+++ b/test/host-adapter.spec.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it } from 'vitest'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { createSystemMessage } from '@deepseek-ai/dsh-llm'
+import { toDriveAgent } from '../src/index.ts'
+import { userTaskMessage } from '../src/prompts.ts'
+
+describe('Harness rc.3 public session adapter', () => {
+  it('sees appended events and replaces conversation context without deleting the system head', () => {
+    const session = Session.create(SessionId('adapter-regression'))
+    const drive = toDriveAgent({ session, steer() {}, async whenIdle() {} } as never).session
+    session.append('system/message', { turn: 0, step: 0, message: createSystemMessage('Preserve host rules.', 'test') }, { surfaceOp: 'append' })
+    expect(drive.surface.nodes).toEqual([])
+    const original = session.append('user/message', userTaskMessage('First task'), { surfaceOp: 'append' })
+    expect(drive.events.length).toBe(2)
+    expect(drive.surface.nodes).toEqual([original.seq])
+    const replacement = drive.replaceSurface(userTaskMessage('Step context'), original.seq, original.seq, [original.seq])
+    expect(session.surface.nodes).toEqual([0, replacement])
+    expect(drive.surface.nodes).toEqual([replacement])
+    expect(drive.events.length).toBe(3)
+    expect(session.snapshotEvents()[0]?.type).toBe('system/message')
+    const next = drive.replaceSurface(userTaskMessage('Next step'), replacement, replacement, [replacement])
+    expect(session.surface.nodes).toEqual([0, next])
+    expect(drive.events.length).toBe(4)
+  })
+})
