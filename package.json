{
  "name": "dsh-architecture-lab",
  "version": "0.1.0-dev.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Controlled DSH memory and planning comparison",
  "exports": {
    ".": "./src/plugin.mjs",
    "./budget": "./src/budget.mjs",
    "./planner-runner": "./src/planner-runner.mjs",
    "./memory-seeder": "./src/memory-seeder.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check:isolation": "node scripts/check-runtime-isolation.mjs",
    "runtime": "node scripts/bootstrap-runtime.mjs",
    "test": "node --test test/*.test.mjs",
    "audit:pilots": "node scripts/audit-pilots.mjs",
    "lab": "node src/cli.mjs",
    "seed": "node scripts/seed-memories.mjs",
    "pricing": "node scripts/refresh-pricing.mjs",
    "profiles": "node scripts/setup-profiles.mjs",
    "evaluator": "node scripts/bootstrap-evaluator.mjs",
    "dsh": "node scripts/open-selected.mjs",
    "engram": "node scripts/bootstrap-engram.mjs",
    "planner": "node scripts/bootstrap-planner.mjs",
    "check:integration": "node scripts/check-brokered-dsh.mjs",
    "check:management": "node scripts/check-management.mjs",
    "check:commands": "node scripts/check-management-commands.mjs",
    "check:memory": "node scripts/check-memory-isolation.mjs",
    "linux": "node scripts/bootstrap-linux.mjs",
    "linux:supervisor": "node scripts/install-linux-supervisor.mjs",
    "check:linux": "node scripts/check-linux-containment.mjs",
    "linux:image": "node scripts/build-linux-image.mjs",
    "check:linux-bridge": "node scripts/check-linux-bridge.mjs",
    "check:linux-dsh": "node scripts/check-linux-dsh.mjs",
    "check:linux-recovery": "node scripts/check-linux-recovery.mjs",
    "audit:historical-budget": "node scripts/reconcile-historical-budget.mjs",
    "check:review": "node scripts/check-protocol-review.mjs",
    "check:daily": "node scripts/check-daily.mjs",
    "check:fixtures": "node scripts/check-research-fixtures.mjs",
    "check:deadline": "node scripts/check-deadline.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2 || 0.1.5-rc.3",
    "@deepseek-ai/dsh-brand": "0.1.5-rc.2 || 0.1.5-rc.3",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2 || 0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2 || 0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2 || 0.1.5-rc.3"
  },
  "engines": {
    "node": ">=24"
  }
}
